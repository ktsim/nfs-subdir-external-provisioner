# Patched image: clean Red Hat UBI micro base + provisioner rebuilt with Go 1.26.9 and updated modules.
# Does NOT layer on the upstream v4.0.2 image, so the old Go 1.15 binary and its dependencies are not carried along.
# Build per architecture, e.g.:
#   podman build --platform linux/amd64 --build-arg binary=./bin/nfs-subdir-external-provisioner_amd64 -f Dockerfile.patched .
FROM registry.access.redhat.com/ubi9/ubi-micro:latest
ARG binary=./bin/nfs-subdir-external-provisioner
LABEL description="NFS subdir external provisioner (patched dependencies and Go toolchain)"
LABEL revision="v4.0.2-patch2"
COPY --chmod=0755 ${binary} /nfs-subdir-external-provisioner
USER 1001
ENTRYPOINT ["/nfs-subdir-external-provisioner"]
